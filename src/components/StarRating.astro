---
interface Props {
  label: string;
  score: number;
  max?: number;
}

const { label, score, max = 5 } = Astro.props;
const stars = Array.from({ length: max }, (_, i) => i < score);
---

<div class="rating-row" aria-label={`${label}: ${score} out of ${max} stars`}>
  <span>{label}</span>
  <span class="rating-stars">
    {stars.map((filled) => (
      <svg
        class={filled ? 'star-filled' : 'star-empty'}
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    ))}
  </span>
</div>
