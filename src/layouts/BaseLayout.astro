---
import '../styles/global.css';
import { getCollection } from 'astro:content';

import {
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  DEFAULT_OG_IMAGE,
  absoluteUrl,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'blog' | 'contact';
  /** Full <title> override (otherwise "{title} | Efficient Travellers"). */
  fullTitle?: string;
  /** Adds <meta name="robots" content="noindex"> (used for unfinished guides). */
  noindex?: boolean;
  /** Social preview image (root-relative path or absolute URL). */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Extra article metadata for social previews. */
  article?: { published?: string; modified?: string; section?: string; tags?: string[]; authors?: string[] };
  /** schema.org JSON-LD objects to embed. */
  jsonLd?: object[];
  /** URL of a plain Markdown copy of the page (for LLMs). */
  markdownUrl?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  activeNav = 'home',
  fullTitle,
  noindex = false,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt,
  ogType = 'website',
  article,
  jsonLd = [],
  markdownUrl,
} = Astro.props;

const pageTitle = fullTitle ?? `${title} | ${SITE_NAME}`;
const pathname = Astro.url.pathname.endsWith('/') || /\.[a-z0-9]+$/i.test(Astro.url.pathname)
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(pathname, Astro.site).href;
const ogImageUrl = absoluteUrl(ogImage);
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const withBase = (path) => {
  if (!path) return path;
  if (path.startsWith(base)) return path;
  if (path.startsWith('/')) return `${base}${path}`;
  return `${base}/${path}`;
};

const allDestinations = await getCollection('destinations');
const searchIndex = allDestinations
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    region: entry.data.region,
    status: entry.data.status,
    highlights: entry.data.highlights.join(', '),
    thumb: withBase(entry.data.cardImage),
    url: withBase(entry.data.status === 'pending' ? '/blog/' : `/blog/${entry.id}/`),
  }));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={article?.authors?.join(', ') ?? 'Carola & Martín'} />

    <!-- Open Graph / social previews -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {article?.published && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Discovery for crawlers and AI agents -->
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — new guides`} href={withBase('/rss.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={withBase('/llms.txt')} />
    {markdownUrl && <link rel="alternate" type="text/markdown" title="Markdown version" href={markdownUrl} />}

    <link rel="icon" type="image/x-icon" href={withBase('/images/home/favicon.ico')} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={`${base}/`} class="brand-logo" id="nav-logo">
          <img src={withBase('/images/home/logo.webp')} alt="Efficient Travellers Logo" width="95" height="40" />
          <span>Efficient Travellers</span>
        </a>

        <nav aria-label="Main Navigation">
          <ul class="nav-links">
            <li>
              <a href={`${base}/`} class={`nav-link ${activeNav === 'home' ? 'active' : ''}`} id="nav-home">Home</a>
            </li>
            <li>
              <a href={`${base}/blog/`} class={`nav-link ${activeNav === 'blog' ? 'active' : ''}`} id="nav-blog">Destinations</a>
            </li>
            <li>
              <a href={`${base}/contact/`} class={`nav-link ${activeNav === 'contact' ? 'active' : ''}`} id="nav-contact">Contact Us</a>
            </li>
          </ul>
        </nav>

        <div class="header-actions">
          <div class="search-wrapper">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              id="global-search-input"
              class="search-input"
              placeholder="Search destinations, cities..."
              autocomplete="off"
              aria-label="Search destinations"
            />
            <div id="global-search-dropdown" class="search-dropdown" role="listbox"></div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <img src={withBase('/images/home/logo.webp')} alt="Efficient Travellers" width="72" height="30" style="filter: brightness(0) invert(1);" />
          <span>Efficient Travellers &mdash; Carola &amp; Martín</span>
        </div>
        <ul class="footer-links">
          <li><a href={`${base}/`}>Home</a></li>
          <li><a href={`${base}/blog/`}>All Destinations</a></li>
          <li><a href={`${base}/contact/`}>Contact Us</a></li>
        </ul>
      </div>
    </footer>

    <script is:inline define:vars={{ searchIndex }}>
      const input = document.getElementById('global-search-input');
      const dropdown = document.getElementById('global-search-dropdown');

      if (input && dropdown) {
        input.addEventListener('input', (e) => {
          const q = e.target.value.trim().toLowerCase();
          if (!q) {
            dropdown.classList.remove('open');
            dropdown.innerHTML = '';
            return;
          }
          const matches = searchIndex.filter(
            (item) =>
              item.title.toLowerCase().includes(q) ||
              item.region.toLowerCase().includes(q) ||
              item.highlights.toLowerCase().includes(q)
          );

          if (matches.length === 0) {
            dropdown.innerHTML = '<div style="padding:12px;font-size:0.88rem;color:#526375;">No matching destinations found.</div>';
          } else {
            dropdown.innerHTML = matches
              .map(
                (m) => `
                <a href="${m.url}" class="search-result-item">
                  <img src="${m.thumb}" alt="${m.title}" class="search-result-thumb" />
                  <div class="search-result-meta">
                    <h6>${m.title}</h6>
                    <span>${m.region}${m.highlights ? ' • ' + m.highlights : ''}</span>
                  </div>
                </a>
              `
              )
              .join('');
          }
          dropdown.classList.add('open');
        });

        document.addEventListener('click', (e) => {
          if (!input.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.remove('open');
          }
        });
      }
    </script>
  </body>
</html>
