---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'blog' | 'contact';
}

const {
  title,
  description = 'Short, clear, and efficient travel guides for savvy travelers — all the essentials without the fluff or spoilers.',
  activeNav = 'home',
} = Astro.props;

const allDestinations = await getCollection('destinations');
const searchIndex = allDestinations
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    region: entry.data.region,
    status: entry.data.status,
    highlights: entry.data.highlights.join(', '),
    thumb: entry.data.cardImage,
    url: entry.data.status === 'pending' ? '/blog/' : `/blog/${entry.id}/`,
  }));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Efficient Travellers</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Efficient Travellers`} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/x-icon" href="/images/home/favicon.ico" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-logo" id="nav-logo">
          <img src="/images/home/logo.webp" alt="Efficient Travellers Logo" width="95" height="40" />
          <span>Efficient Travellers</span>
        </a>

        <nav aria-label="Main Navigation">
          <ul class="nav-links">
            <li>
              <a href="/" class={`nav-link ${activeNav === 'home' ? 'active' : ''}`} id="nav-home">Home</a>
            </li>
            <li>
              <a href="/blog/" class={`nav-link ${activeNav === 'blog' ? 'active' : ''}`} id="nav-blog">Destinations</a>
            </li>
            <li>
              <a href="/contact/" class={`nav-link ${activeNav === 'contact' ? 'active' : ''}`} id="nav-contact">Contact Us</a>
            </li>
          </ul>
        </nav>

        <div class="header-actions">
          <div class="search-wrapper">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              id="global-search-input"
              class="search-input"
              placeholder="Search destinations, cities..."
              autocomplete="off"
              aria-label="Search destinations"
            />
            <div id="global-search-dropdown" class="search-dropdown" role="listbox"></div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <img src="/images/home/logo.webp" alt="Efficient Travellers" width="72" height="30" style="filter: brightness(0) invert(1);" />
          <span>Efficient Travellers &mdash; Carola &amp; Martín</span>
        </div>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/blog/">All Destinations</a></li>
          <li><a href="/contact/">Contact Us</a></li>
        </ul>
      </div>
    </footer>

    <script is:inline define:vars={{ searchIndex }}>
      const input = document.getElementById('global-search-input');
      const dropdown = document.getElementById('global-search-dropdown');

      if (input && dropdown) {
        input.addEventListener('input', (e) => {
          const q = e.target.value.trim().toLowerCase();
          if (!q) {
            dropdown.classList.remove('open');
            dropdown.innerHTML = '';
            return;
          }
          const matches = searchIndex.filter(
            (item) =>
              item.title.toLowerCase().includes(q) ||
              item.region.toLowerCase().includes(q) ||
              item.highlights.toLowerCase().includes(q)
          );

          if (matches.length === 0) {
            dropdown.innerHTML = '<div style="padding:12px;font-size:0.88rem;color:#526375;">No matching destinations found.</div>';
          } else {
            dropdown.innerHTML = matches
              .map(
                (m) => `
                <a href="${m.url}" class="search-result-item">
                  <img src="${m.thumb}" alt="${m.title}" class="search-result-thumb" />
                  <div class="search-result-meta">
                    <h6>${m.title}</h6>
                    <span>${m.region}${m.highlights ? ' • ' + m.highlights : ''}</span>
                  </div>
                </a>
              `
              )
              .join('');
          }
          dropdown.classList.add('open');
        });

        document.addEventListener('click', (e) => {
          if (!input.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.remove('open');
          }
        });
      }
    </script>
  </body>
</html>
