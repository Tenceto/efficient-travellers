---
// Old address of each guide (/blog/<slug>/) -> new address (/destinations/<slug>/).
import { getCollection } from 'astro:content';
import Redirect from '../../components/Redirect.astro';
import { isIndexable } from '../../lib/seo';

export async function getStaticPaths() {
  const entries = (await getCollection('destinations')).filter(isIndexable);
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
---

<Redirect to={`/destinations/${slug}/`} />
