---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HOME_URL, absoluteUrl, breadcrumbNode } from '../lib/seo';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const contactUrl = absoluteUrl('/contact/');
const contactJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${contactUrl}#webpage`,
      url: contactUrl,
      name: 'Contact Us',
      isPartOf: { '@id': `${HOME_URL}#website` },
      about: { '@id': `${HOME_URL}#organization` },
    },
    breadcrumbNode([
      { name: 'Home', url: HOME_URL },
      { name: 'Contact Us', url: contactUrl },
    ]),
  ],
};
---

<BaseLayout
  title="Contact Us"
  description="Have a question about one of our itineraries, local driver contacts, or travel recommendations? Send us a DM on Instagram!"
  activeNav="contact"
  ogImage="/images/home/destinations-hero.jpeg"
  jsonLd={[contactJsonLd]}
>
  <section class="page-hero page-hero--solid">
    <div class="page-hero-content">
      <h1>Contact Us</h1>
      <p>Please let us know if we can help with itineraries, local guide contacts, or travel tips!</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-card">
        <p style="text-align: center; margin-bottom: 24px;">
          The easiest way to reach us is to send us a DM on Instagram. We're happy to help with itineraries, local guide contacts, or any travel questions!
        </p>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <a href="https://www.instagram.com/martinsevilla_/" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="width: 100%; text-align: center;">
            Martín &middot; @martinsevilla_
          </a>
          <a href="https://www.instagram.com/caroisella/" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="width: 100%; text-align: center;">
            Carola &middot; @caroisella
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
