---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us"
  description="Have a question about one of our itineraries, local driver contacts, or travel recommendations? Send us a message!"
  activeNav="contact"
>
  <section class="page-hero" style="background-image: url('/images/home/destinations-hero.jpeg'); min-height: 260px;">
    <div class="page-hero-content">
      <h1>Contact Us</h1>
      <p>Please let us know if we can help with itineraries, local guide contacts, or travel tips!</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-card">
        <form
          id="contact-form"
          action="https://formspree.io/f/your-form-id"
          method="POST"
        >
          <div class="form-group">
            <label for="contact-name">Your Name *</label>
            <input type="text" id="contact-name" name="name" class="form-control" required placeholder="Carola & Martín" />
          </div>

          <div class="form-group">
            <label for="contact-email">Your Email *</label>
            <input type="email" id="contact-email" name="email" class="form-control" required placeholder="you@example.com" />
          </div>

          <div class="form-group">
            <label for="contact-subject">Subject *</label>
            <input type="text" id="contact-subject" name="subject" class="form-control" required placeholder="Question about Indonesia / Rinjani guide contact" />
          </div>

          <div class="form-group">
            <label for="contact-message">Your Question *</label>
            <textarea id="contact-message" name="message" rows="5" class="form-control" required placeholder="Write your message here..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary" id="contact-submit-btn" style="width: 100%;">
            Send Message
          </button>

          <p style="margin-top: 16px; font-size: 0.82rem; color: var(--color-text-muted); text-align: center;">
            Static site form ready for GitHub Pages (connects to Formspree / Web3Forms in one line).
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
