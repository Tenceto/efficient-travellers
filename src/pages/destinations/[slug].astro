---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StarRating from '../../components/StarRating.astro';
import TripMap from '../../components/TripMap.astro';
import { getCollection, render } from 'astro:content';
import {
  getDescription,
  getSeoTitle,
  guideJsonLd,
  guideMarkdownUrl,
  isIndexable,
  modifiedDate,
  publishedDate,
} from '../../lib/seo';

export async function getStaticPaths() {
  // Only published guides get a page; "wip" and "pending" stay unreachable.
  const entries = (await getCollection('destinations')).filter(isIndexable);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const coverImage = entry.data.coverImage.startsWith(base)
  ? entry.data.coverImage
  : entry.data.coverImage.startsWith('/')
    ? `${base}${entry.data.coverImage}`
    : entry.data.coverImage;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((h) => h.depth === 2);
// "Map" goes in the table of contents right after the Itinerary section (or last).
const mapTocIndex = entry.data.places.length === 0
  ? -1
  : (() => {
      const i = tocHeadings.findIndex((h) => h.slug === 'itinerary');
      return i >= 0 ? i : tocHeadings.length - 1;
    })();

// SEO (all derived from the frontmatter — see src/lib/seo.ts)
const indexable = isIndexable(entry);
---

<BaseLayout
  title={entry.data.title}
  fullTitle={getSeoTitle(entry)}
  description={getDescription(entry)}
  activeNav="destinations"
  noindex={!indexable}
  ogType="article"
  ogImage={entry.data.coverImage}
  ogImageAlt={entry.data.title}
  article={{
    published: publishedDate(entry),
    modified: modifiedDate(entry),
    section: entry.data.region,
    tags: entry.data.highlights,
    authors: [entry.data.author],
  }}
  jsonLd={indexable ? [guideJsonLd(entry)] : []}
  markdownUrl={indexable ? guideMarkdownUrl(entry) : undefined}
>
  <section class="page-hero" style={`background-image: url('${coverImage}'); min-height: 380px;`}>
    <div class="page-hero-content">
      <div style="margin-bottom: 12px;">
        <a
          href={`${base}/destinations/`}
          style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: rgba(173, 239, 209, 0.22); color: var(--color-mint); font-size: 0.82rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;"
        >
          &larr; {entry.data.region}
        </a>
      </div>
      <h1>{entry.data.title}</h1>
      <div class="post-header-meta">
        <span>By {entry.data.author}</span>
        {entry.data.date && <span>&bull; {entry.data.date}</span>}
        {entry.data.highlights.length > 0 && (
          <span>&bull; {entry.data.highlights.join(' • ')}</span>
        )}
      </div>
    </div>
  </section>

  <div class="container post-layout">
    <aside class="toc-sidebar" aria-label="Table of Contents">
      <div class="toc-title">Table of Contents</div>
      <ul class="toc-list">
        {tocHeadings.map((h, i) => (
          <>
            <li>
              <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
            </li>
            {i === mapTocIndex && (
              <li>
                <a href="#trip-map" class="toc-link">Map</a>
              </li>
            )}
          </>
        ))}
      </ul>

      {entry.data.hasRatings && (
        <div class="toc-ratings-card">
          <div class="toc-title" style="margin-bottom: 10px;">Our Ratings</div>
          <StarRating label="Budget-friendly" score={entry.data.ratings.budget} />
          <StarRating label="Adventure" score={entry.data.ratings.adventure} />
          <StarRating label="Food" score={entry.data.ratings.food} />
          <StarRating label="Overall" score={entry.data.ratings.overall} />
        </div>
      )}

      <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.14);">
        <a href={`${base}/destinations/`} style="color: var(--color-mint); font-size: 0.88rem; font-weight: 600;">
          &larr; All Destinations
        </a>
      </div>
    </aside>

    <article class="post-prose">
      <Content />
      {entry.data.places.length > 0 && <TripMap places={entry.data.places} headings={headings} route={entry.data.mapRoute} />}
    </article>
  </div>
</BaseLayout>
